---
export const prerender = false;

import PortalLayout from '../../../layouts/PortalLayout.astro';
import { queryAll } from '../../../lib/db';
import type { Project } from '../../../types/diary';

const { env } = Astro.locals.runtime;
const user = Astro.locals.user;

// The projects this client is attached to. Empty when the invitation carried no
// project_id — the account is fine, it just has no `project_clients` rows. The
// empty state below has to say so: a bare portal reads as deleted work.
const projects = user
  ? await queryAll<Project>(
      env.DB,
      `SELECT p.* FROM projects p
         JOIN project_clients pc ON pc.project_id = p.id
        WHERE pc.user_id = ? ORDER BY p.updated_at DESC`,
      [user.id]
    )
  : [];

// Unread replies from the team, and approvals still waiting on this client.
const unread: Record<string, number> = {};
const awaiting: Record<string, number> = {};

if (user) {
  const unreadRows = await queryAll<{ project_id: string; unread: number }>(
    env.DB,
    `SELECT m.project_id, COUNT(*) AS unread
       FROM messages m
       LEFT JOIN message_reads r
              ON r.project_id = m.project_id AND r.user_id = ?
      WHERE m.project_id IN (SELECT project_id FROM project_clients WHERE user_id = ?)
        AND m.user_id != ?
        AND (r.last_read_at IS NULL OR m.created_at > r.last_read_at)
      GROUP BY m.project_id`,
    [user.id, user.id, user.id]
  );
  for (const row of unreadRows) unread[row.project_id] = row.unread;

  const approvalRows = await queryAll<{ project_id: string; n: number }>(
    env.DB,
    `SELECT project_id, COUNT(*) AS n FROM approval_requests
      WHERE status = 'pending' AND required_level = 'client'
        AND project_id IN (SELECT project_id FROM project_clients WHERE user_id = ?)
      GROUP BY project_id`,
    [user.id]
  );
  for (const row of approvalRows) awaiting[row.project_id] = row.n;
}
---

<PortalLayout title="Your Projects">
  <h1 class="text-2xl font-bold text-gray-900 mb-1">Welcome{user?.name ? `, ${user.name.split(' ')[0]}` : ''}</h1>
  <p class="text-gray-500 text-sm mb-6">Your project updates and approvals.</p>

  {projects.length > 0 ? (
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {projects.map((p) => (
        <a href={`/project-hub/portal/${p.id}`} class="bg-white rounded-lg shadow-sm border border-gray-200 p-5 hover:shadow-md transition-all">
          <h3 class="font-semibold text-gray-900">{p.name}</h3>
          <p class="text-sm text-gray-500 mt-1">{p.address}</p>
          <div class="flex flex-wrap items-center gap-2 mt-3">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800 capitalize">{p.status}</span>
            {unread[p.id] > 0 && (
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-red-500 text-white">
                {unread[p.id]} new message{unread[p.id] === 1 ? '' : 's'}
              </span>
            )}
            {awaiting[p.id] > 0 && (
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-500 text-white">
                {awaiting[p.id]} awaiting your approval
              </span>
            )}
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="bg-white rounded-lg border border-gray-200 p-10 text-center">
      <h2 class="text-base font-semibold text-gray-900">No projects have been shared with you yet</h2>
      <p class="text-sm text-gray-500 mt-2 max-w-md mx-auto">
        Your account is set up correctly — your contractor just hasn't given it access
        to a project yet. Nothing has been removed, and updates will appear here as
        soon as they do.
      </p>
      <p class="text-sm text-gray-500 mt-4">
        Expecting to see a project? Contact Maintain London on
        <a href="mailto:team@maintainlondon.co.uk" class="underline">team@maintainlondon.co.uk</a>
        or 020 3886 2023.
      </p>
    </div>
  )}
</PortalLayout>
