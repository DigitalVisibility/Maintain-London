---
export const prerender = false;

import HubLayout from '../../layouts/HubLayout.astro';
import PhotoBrowser from '../../components/project-hub/PhotoBrowser';
import { isStaff } from '../../lib/capabilities';

// Staff only — clients get the portal.
if (!isStaff(Astro.locals.role)) return Astro.redirect('/project-hub/');

const projectId = Astro.url.searchParams.get('project_id') || undefined;
const from = Astro.url.searchParams.get('from') || undefined;
---

<HubLayout title="Photos">
  <div class="max-w-5xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-900 font-display mb-6">Photos</h1>
    <PhotoBrowser client:load projectId={projectId} initialFrom={from} />
  </div>
</HubLayout>
