---
export const prerender = false;

import HubLayout from '../../layouts/HubLayout.astro';
import { queryAll } from '../../lib/db';
import { isStaff } from '../../lib/capabilities';

// Staff only — clients get the portal.
if (!isStaff(Astro.locals.role)) return Astro.redirect('/project-hub/');

const { env } = Astro.locals.runtime;
const orgId = Astro.locals.org?.id;
const from = Astro.url.searchParams.get('from') || undefined;

interface Row {
  id: string; date: string; site_manager: string; project_id: string; project_name: string; photo_count: number;
}
let entries: Row[] = [];
if (orgId) {
  let sql = `SELECT de.id, de.date, de.site_manager, de.project_id, pr.name AS project_name,
                    (SELECT COUNT(*) FROM entry_files f WHERE f.entry_id = de.id AND f.mime_type LIKE 'image/%') AS photo_count
               FROM diary_entries de JOIN projects pr ON pr.id = de.project_id
              WHERE pr.org_id = ?`;
  const params: unknown[] = [orgId];
  if (from) { sql += ' AND de.date >= date(?)'; params.push(from); }
  sql += ' ORDER BY de.date DESC LIMIT 200';
  entries = await queryAll<Row>(env.DB, sql, params);
}

const heading = from ? 'Recent entries' : 'All entries';
---

<HubLayout title="Entries">
  <div class="max-w-3xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-gray-900 font-display">{heading}</h1>
      <span class="text-sm text-gray-400">{entries.length} shown</span>
    </div>

    {entries.length > 0 ? (
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 divide-y divide-gray-100">
        {entries.map((e) => {
          const d = new Date(e.date + 'T00:00:00');
          return (
            <a href={`/project-hub/project/${e.project_id}/diary/${e.id}`} class="flex items-center justify-between gap-3 px-4 py-3 hover:bg-gray-50 transition-colors">
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center text-sm font-semibold text-gray-600 shrink-0">
                  {d.getDate()}
                </div>
                <div class="min-w-0">
                  <div class="text-sm font-medium text-gray-900 truncate">{e.project_name}</div>
                  <div class="text-xs text-gray-500">{d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' })} · {e.site_manager}</div>
                </div>
              </div>
              <div class="flex items-center gap-3 shrink-0">
                {e.photo_count > 0 && (
                  <span class="text-xs text-gray-400 inline-flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd" /></svg>
                    {e.photo_count}
                  </span>
                )}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010 1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" /></svg>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8 text-center">
        <p class="text-sm text-gray-500">No entries to show.</p>
      </div>
    )}
  </div>
</HubLayout>
