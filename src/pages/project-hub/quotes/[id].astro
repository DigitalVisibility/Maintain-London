---
export const prerender = false;

import HubLayout from '../../../layouts/HubLayout.astro';
import { hasCap } from '../../../lib/capabilities';
import { loadQuoteRow } from '../../../lib/quotes';
import QuoteBuilder from '../../../components/project-hub/QuoteBuilder';

// Same gate as the list: a job being priced is commercially sensitive, and
// manage_quotes is the capability that decides who sees it.
if (!hasCap(Astro.locals, 'manage_quotes')) return Astro.redirect('/project-hub/');

const { env } = Astro.locals.runtime;
const orgId = Astro.locals.org?.id;
const { id } = Astro.params;
if (!orgId || !id) return Astro.redirect('/project-hub/quotes');

// Load the row first, then authorise from the row's own org_id — never from
// anything in the URL beyond the id itself.
const quote = await loadQuoteRow(env.DB, id);
if (!quote || quote.org_id !== orgId) return Astro.redirect('/project-hub/quotes');
---

<HubLayout title={quote.title}>
  <div class="max-w-5xl mx-auto">
    <a href="/project-hub/quotes" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 mb-4 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
      </svg>
      All quotes
    </a>

    <!-- client:load rather than client:visible: the builder is the entire page,
         and a quote that appears a beat after the shell reads as a broken page. -->
    <QuoteBuilder quoteId={quote.id} client:load />
  </div>
</HubLayout>
