---
import '@fontsource-variable/inter';
import '@fontsource/plus-jakarta-sans/latin-400.css';
import '@fontsource/plus-jakarta-sans/latin-600.css';
import '@fontsource/plus-jakarta-sans/latin-700.css';
import OfflineBanner from '../components/project-hub/OfflineBanner';
import SignOutButton from '../components/project-hub/SignOutButton';
import { hasCap } from '../lib/capabilities';

interface Props {
  title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user;
const currentPath = Astro.url.pathname;

// Active organisation (tenant) branding + the user's role within it.
const org = Astro.locals.org;
const memberships = Astro.locals.memberships ?? [];
const orgName = org?.name ?? 'Maintain London';
const orgLogo = org?.logo_url || '/images/Icons/Stacked.png';
const brandColor = org?.brand_color || '#AEDE4A';
const orgRole = Astro.locals.role ?? user?.role ?? 'operative';
const canManageUsers = hasCap(Astro.locals, 'manage_users');
const canViewCosts = hasCap(Astro.locals, 'view_costs');
const canReleaseToClient = hasCap(Astro.locals, 'release_to_client');
const isPlatformAdmin = Astro.locals.isPlatformAdmin;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Project Hub | Maintain London</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content={brandColor} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Project Hub" />
    <link rel="apple-touch-icon" href="/images/Icons/Stacked.png" />
  </head>
  <body class="bg-gray-50 font-sans">
    <div class="flex h-screen overflow-hidden">
      <!-- Sidebar (desktop) -->
      <aside class="hidden md:flex md:w-64 md:flex-col bg-gray-900 text-white">
        <!-- Logo -->
        <div class="flex items-center gap-3 px-6 py-5 border-b border-gray-800">
          <img
            src={orgLogo}
            alt={orgName}
            class="h-10 w-auto"
          />
          <div>
            <div class="text-sm font-semibold">Project Hub</div>
            <div class="text-xs text-gray-400">{orgName}</div>
          </div>
        </div>

        {memberships.length > 1 && (
          <div class="px-4 pt-3">
            <label class="block text-[11px] uppercase tracking-wide text-gray-500 mb-1">Business</label>
            <select
              id="org-switcher"
              class="w-full bg-gray-800 text-white text-sm rounded-md px-2 py-1.5 border border-gray-700 focus:outline-none focus:ring-2 focus:ring-brand-green"
            >
              {memberships.map((m) => (
                <option value={m.org_id} selected={m.org_id === org?.id}>{m.org_name}</option>
              ))}
            </select>
          </div>
        )}

        <!-- Nav links -->
        <nav class="flex-1 px-4 py-4 space-y-1">
          {isPlatformAdmin && (
            <a
              href="/project-hub/agency"
              class="flex items-center gap-3 px-3 py-2 rounded-md text-sm text-[#AEDE4A] hover:bg-gray-800 transition-colors mb-1"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              All businesses
            </a>
          )}
          <a
            href="/project-hub/"
            class:list={[
              'flex items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors',
              currentPath === '/project-hub/' || currentPath === '/project-hub'
                ? 'bg-brand-green/20 text-brand-green'
                : 'text-gray-300 hover:bg-gray-800 hover:text-white',
            ]}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
            </svg>
            Dashboard
          </a>

          {canManageUsers && (
            <a
              href="/project-hub/team"
              class:list={[
                'flex items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors',
                currentPath.startsWith('/project-hub/team')
                  ? 'bg-brand-green/20 text-brand-green'
                  : 'text-gray-300 hover:bg-gray-800 hover:text-white',
              ]}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z" />
              </svg>
              Team &amp; Clients
            </a>
          )}

          {canReleaseToClient && (
            <a
              href="/project-hub/updates"
              class:list={[
                'flex items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors',
                currentPath.startsWith('/project-hub/updates')
                  ? 'bg-brand-green/20 text-brand-green'
                  : 'text-gray-300 hover:bg-gray-800 hover:text-white',
              ]}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
              </svg>
              Client updates
            </a>
          )}

          {canViewCosts && (
            <a
              href="/project-hub/timesheets"
              class:list={[
                'flex items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors',
                currentPath.startsWith('/project-hub/timesheets')
                  ? 'bg-brand-green/20 text-brand-green'
                  : 'text-gray-300 hover:bg-gray-800 hover:text-white',
              ]}
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
              </svg>
              Timesheets
            </a>
          )}

          <a
            href="/project-hub/settings"
            class:list={[
              'flex items-center gap-3 px-3 py-2 rounded-md text-sm transition-colors',
              currentPath.startsWith('/project-hub/settings')
                ? 'bg-brand-green/20 text-brand-green'
                : 'text-gray-300 hover:bg-gray-800 hover:text-white',
            ]}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
            </svg>
            Settings
          </a>
        </nav>

        <!-- User section -->
        <div class="px-4 py-4 border-t border-gray-800">
          <div class="flex items-center gap-3 px-3">
            <div class="w-8 h-8 rounded-full bg-brand-green/20 flex items-center justify-center text-brand-green text-sm font-semibold">
              {user?.name?.charAt(0)?.toUpperCase() || 'U'}
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-medium text-white truncate">{user?.name || 'User'}</div>
              <div class="text-xs text-gray-400 truncate capitalize">{orgRole}</div>
            </div>
          </div>
          <div class="mt-3">
            <SignOutButton client:load className="w-full text-left px-3 py-2 text-sm text-gray-400 hover:text-white hover:bg-gray-800 rounded-md transition-colors">
              Sign Out
            </SignOutButton>
          </div>
        </div>
      </aside>

      <!-- Main content -->
      <div class="flex-1 flex flex-col overflow-hidden">
        <!-- Offline/sync banner -->
        <OfflineBanner client:load />

        <!-- Top bar (mobile) -->
        <header class="md:hidden flex items-center justify-between bg-white border-b border-gray-200 px-4 py-3">
          <div class="flex items-center gap-2">
            <img src={orgLogo} alt={orgName} class="h-8 w-auto" />
            <span class="text-sm font-semibold text-gray-900">Project Hub</span>
          </div>
          <div class="w-8 h-8 rounded-full bg-brand-green/20 flex items-center justify-center text-brand-green text-sm font-semibold">
            {user?.name?.charAt(0)?.toUpperCase() || 'U'}
          </div>
        </header>

        <!-- Page content -->
        <main class="flex-1 overflow-y-auto p-4 md:p-6 lg:p-8">
          <slot />
        </main>

        <!-- Bottom tab bar (mobile) -->
        <nav class="md:hidden flex items-center justify-around bg-white border-t border-gray-200 py-2">
          <a
            href="/project-hub/"
            class:list={[
              'flex flex-col items-center gap-1 px-3 py-1 text-xs',
              currentPath === '/project-hub/' || currentPath === '/project-hub'
                ? 'text-brand-green'
                : 'text-gray-400',
            ]}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
            </svg>
            Dashboard
          </a>
          <a
            href="/project-hub/settings"
            class:list={[
              'flex flex-col items-center gap-1 px-3 py-1 text-xs',
              currentPath.startsWith('/project-hub/settings')
                ? 'text-brand-green'
                : 'text-gray-400',
            ]}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
            </svg>
            Settings
          </a>
        </nav>
      </div>
    </div>
    <!-- Org switcher: switch active business then reload -->
    <script is:inline>
      (function () {
        var sw = document.getElementById('org-switcher');
        if (!sw) return;
        sw.addEventListener('change', async function () {
          try {
            await fetch('/api/org/switch', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ org_id: sw.value }),
            });
            window.location.href = '/project-hub/';
          } catch (e) {
            window.location.reload();
          }
        });
      })();
    </script>

    <!-- Service Worker Registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js', { scope: '/project-hub/' })
            .catch(() => {});
        });
      }
    </script>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    padding: 0;
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  .font-display {
    font-family: 'Inter Variable', system-ui, sans-serif;
  }
</style>
